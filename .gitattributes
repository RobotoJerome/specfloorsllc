# Normalize text files to LF in the repo; Git checks them out with the
# platform's native endings. Keeps diffs clean across machines.
* text=auto

*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf

# Never touch binary assets
*.jpg   binary
*.jpeg  binary
*.png   binary
*.webp  binary
*.heic  binary
*.ico   binary
